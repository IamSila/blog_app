# ============================================================
# Demo environment file for blog_app (Django)
# Copy to `.env` in the project root (next to manage.py):
#   cp .env.example .env
# All values below are FAKE placeholders. Replace before real use.
# ============================================================

# ---- REQUIRED: read by mysite/settings.py via python-decouple ----
# Django will crash on startup (UndefinedValueError) if these are missing.

# Gmail account used to send "share post by email" messages
EMAIL_HOST_USER=demo.blog.sender@gmail.com

# Gmail *App Password* (16 chars, requires 2-Step Verification),
# NOT your normal Gmail password
EMAIL_HOST_PASSWORD=abcdwxyzabcdwxyz

# "From" address on outgoing mail (usually same as EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=My Blog <demo.blog.sender@gmail.com>


# ---- OPTIONAL: PostgreSQL (currently commented out in settings.py) ----
# The app runs on SQLite by default. These are only needed if you
# uncomment the PostgreSQL block in DATABASES. Note: the search view
# uses django.contrib.postgres.search, which needs PostgreSQL to work.

# DB_NAME=blog_db
# DB_USER=blog_user
# DB_PASSWORD=change-me-demo-password
# DB_HOST=localhost
# PORT=5432   # NOTE: settings.py reads this as config('PORT'), not DB_PORT


# ---- NOT READ YET: currently hardcoded in settings.py ----
# Suggested to move these to env (would require editing settings.py):

# SECRET_KEY=demo-insecure-key-replace-with-a-long-random-string
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
